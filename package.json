{
    "name": "buylla",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "start": "node ./src/server.ts",
        "dev": "npm run db:up && npm run db:migrate && node --watch ./src/server.ts",
        "setup": "bash ./scripts/setup-local.sh",
        "db:up": "docker compose up --wait postgres",
        "db:down": "docker compose down",
        "db:migrate": "node-pg-migrate up",
        "db:seed": "bash ./scripts/seed-development.sh",
        "db:reset": "bash ./scripts/reset-database.sh",
        "db:shell": "docker compose exec postgres sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
        "build": ""
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "pg": "^8.22.0",
        "node-pg-migrate": "^9.0.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/pg": "^8.20.0"
    }
}
